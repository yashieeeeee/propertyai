# Required: get a free key at https://openrouter.ai/keys (keep it server-side only)
OPENROUTER_API_KEY=sk-or-v1-replace-me
# Free model (verified $0 on OpenRouter). Fallbacks are tried if it is rate-limited.
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
APP_URL=http://localhost:3000
PORT=3000
DB_PATH=/app/data/propertyai.db
# Live scraping of both sites in the background at startup (seed data is always available)
SCRAPE_ON_START=true
SCRAPE_EVERY_HOURS=24
# Comma-separated origins allowed by CORS (only needed if the frontend is hosted elsewhere)
ALLOWED_ORIGINS=*
